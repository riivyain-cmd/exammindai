  // Cloud Variables (Manual Save Control)
  const [isSaving, setIsSaving] = useState(false);
  const [savedCode, setSavedCode] = useState(null);
  const [paperAuthorId, setPaperAuthorId] = useState(null);
  const [mySavedPapers, setMySavedPapers] = useState([]);
  const [isLoadingLibrary, setIsLoadingLibrary] = useState(false);
  const [searchCode, setSearchCode] = useState("");
  const [hasLoadedInitial, setHasLoadedInitial] = useState(false);
  
  const sourceTextRef = useRef(null);
  const pdfRef = useRef(null);

  // Auto-Zoom for Mobile
  useEffect(() => {
    const w = window.innerWidth;
    if (w < 400) setZoomLevel(0.40);
    else if (w < 500) setZoomLevel(0.48);
    else if (w < 640) setZoomLevel(0.60);
    else if (w < 800) setZoomLevel(0.80);
