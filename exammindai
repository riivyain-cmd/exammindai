  const getScoreData = () => {
    let c = 0, w = 0, u = 0;
    questions.forEach(q => {
        const ans = studentAnswers[q.id];
        if (ans === undefined || ans === 4) u++;
        else if (ans === q.correct_index) c++;
        else w++;
    });
    
    const tQ = questions.length || 1;
    const mM = Number(maxMarks) || 200;
    const mpq = mM / tQ;
    const neg = mpq / 3;
    const s = (c * mpq) - (w * neg);
    
    return { 
      correct: c, 
      wrong: w, 
      unattempted: u, 
      score: isNaN(s) ? "0.00" : s.toFixed(2), 
      total: mM 
    };
  };

